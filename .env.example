# Supabase - public, safe for client-side code (filled in during Phase 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase - server-only secret. NEVER prefix with NEXT_PUBLIC_ and never
# reference it from client components. Used only in server-side admin
# operations (e.g. storage cleanup) added in later phases.
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
