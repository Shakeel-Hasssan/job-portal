# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must never be committed.
#
# NOTE: NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time,
# not read at runtime. They must be present wherever `npm run build` runs, not
# only in the deployed environment.

# --- Supabase: public, safe for client-side code -----------------------------
# Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API Keys. The publishable (anon) key is designed to be
# public; every query it makes is still gated by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Site --------------------------------------------------------------------
# Canonical public origin, no trailing slash. Used for canonical URLs, the
# sitemap and Open Graph tags. MUST be the real domain in production, or you
# will publish links pointing at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase: server-only secret --------------------------------------------
# NOT required by any current feature. This key bypasses Row Level Security
# entirely. Never prefix it with NEXT_PUBLIC_, never reference it from client
# code, and never put it in wrangler.jsonc (that file is committed).
# On Cloudflare, set it with: npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=
